[alias]
	fomo = "!fish -c 'git fetch origin $(__git.default_branch) && git rebase origin/$(__git.default_branch) --autostash'"
	lg = "!fish -c 'git_log_n $argv'"
	nuke = "!git add --all && git stash && git stash clear"

[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[commit]
	gpgSign = true

[core]
	editor = "nvim"
	fsmonitor = true

[fetch]
	prune = true
	writeCommitGraph = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = "ssh"

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[rebase]
	updateRefs = true

[rerere]
	enabled = true

[tag]
	gpgSign = true

[user]
	email = "jonnie.lappen@gmail.com"
	name = "Jonnie Lappen"
	signingKey = "~/.ssh/id_ed25519.pub"

# Machine-specific personal identity/signing settings stay outside this repo.
[include]
	path = "~/.config/git/local_config"

[includeIf "gitdir:~/Code/work/"]
	path = "~/.config/git/work_config"

# Match the repository remote so worktrees and alternate checkout paths work too.
[includeIf "hasconfig:remote.*.url:git@gitlab.cfdata.org:*/**"]
	path = "~/.config/git/work_config"
[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.cfdata.org/**"]
	path = "~/.config/git/work_config"
[includeIf "hasconfig:remote.*.url:https://gitlab.cfdata.org/**"]
	path = "~/.config/git/work_config"
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
