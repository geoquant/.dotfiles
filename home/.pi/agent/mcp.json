{
  "mcpServers": {
    "executor": {
      "url": "https://executor.sh/jonnie/mcp"
    },
    "github-code-search": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLS=search_code",
        "-e",
        "GITHUB_READ_ONLY=1",
        "ghcr.io/github/github-mcp-server:v1.12.2"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "!gh auth token"
      }
    },
    "cf-portal": {
      "url": "https://portal.mcp.cfdata.org/mcp?codemode=search_and_execute"
    },
    "uidotsh": {
      "url": "https://ui.sh/mcp?agent=pi",
      "headers": {
        "Authorization": "Bearer ${UIDOTSH_TOKEN}"
      }
    },
    "agentation": {
      "command": "npx",
      "args": ["-y", "agentation-mcp", "server"]
    },
    "computer": {
      "command": "open-computer-use",
      "args": ["mcp"],
      "timeout": 60
    }
  }
}
